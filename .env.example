# HeyGen Configuration
HEYGEN_API_KEY=your_heygen_api_key_here

# Avatar Configuration
NEXT_PUBLIC_DEFAULT_AVATAR_ID=your_avatar_id_here
NEXT_PUBLIC_DEFAULT_KNOWLEDGE_ID=your_knowledge_id_here
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_AVATAR_NAME=your_avatar_name
NEXT_PUBLIC_AVATAR_TAGLINE=your_tagline

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=your_connection_string_here
AZURE_STORAGE_CONFIG_BLOB=your_config_blob_here

# Azure Search
AZURE_SEARCH_SERVICE=your_search_service_url
AZURE_SEARCH_API_KEY=your_search_key_here

# Azure Speech
AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=your_region
AZURE_SPEECH_ENDPOINT=your_speech_endpoint

# Azure OpenAI
AZURE_OPENAI_API_KEY=your_openai_key_here
AZURE_OPENAI_ENDPOINT=your_openai_endpoint_here
